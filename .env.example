# ============================================================
# NOVA Dental Studio — Environment Variables
# ============================================================
# كل المتغيرات هنا اختيارية للمعاينة:
# الموقع يشتغل في "وضع العرض التجريبي" ببيانات جاهزة بدون Supabase،
# والحجز/تسجيل الدخول بيوضحوا للمستخدم إن الربط مطلوب.
# لتفعيل الحجز الحقيقي وتسجيل دخول الطاقم: املأ متغيرات Supabase.

# --- Supabase (اختياري) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- الموقع ---
# في Vercel: ضع دومين الموقع النهائي هنا (يُستخدم في canonical / OG / sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NOVA Dental Studio

# --- Environment ---
# NODE_ENV=development

# ⚠️ لا تضع SUPABASE_SERVICE_ROLE_KEY في أي متغير يبدأ بـ NEXT_PUBLIC_
#    (كل متغير NEXT_PUBLIC_ يظهر في كود المتصفح).
